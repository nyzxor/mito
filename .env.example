# MITO environment overrides (ADR-0011). Copy to .env for local dev. Never commit .env.
# Secrets do NOT go here in production: use `mito vault add <handle>` (OS keyring / vault).
# These are the only env vars the runtime reads; everything else is TOML + vault.

# State directory (Handbrake `control/` and runtime `runtime/` live under it)
MITO_HOME=~/.mito

# Local inference (L1). OpenAI-compatible endpoint.
MITO_LOCAL_BASE_URL=http://127.0.0.1:8080/v1

# Handbrake API bind (must stay loopback in dev; compose uses the internal network)
MITO_HANDBRAKE_BIND=127.0.0.1:8710
MITO_EGRESS_PROXY_BIND=127.0.0.1:8711

# Force DEV MODE (weaker isolation; autonomy capped at A1). Auto-set on bare Windows.
MITO_DEV_MODE=0

# Cloud provider API keys are NOT set here. Register them as credential handles:
#   mito vault add cred:openrouter        (prompts for the key, stores in keyring/vault)
# and reference the handle in config/models.toml.
